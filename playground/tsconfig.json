{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@go-wind-ui/element-pro": [
        "../packages/element-pro/src/index.ts"
      ],
      "@go-wind-ui/bi-vue": [
        "../packages/bi-vue/src/index.ts"
      ],
      "@go-wind-ui/bi-core": [
        "../packages/bi-core/src/index.ts"
      ],
      "@go-wind-ui/bi-engine-s2": [
        "../packages/bi-engine-s2/src/index.ts"
      ],
      "@go-wind-ui/bi-engine-g6": [
        "../packages/bi-engine-g6/src/index.ts"
      ],
      "@go-wind-ui/widgets-vue": [
        "../packages/widgets-vue/src/index.ts"
      ],
      "@go-wind-ui/chat-vue": [
        "../packages/chat-vue/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
