{
  "name": "@go-wind/editor-react",
  "version": "0.2.4",
  "description": "React 19 editor suite: Tiptap 3 rich text, Monaco code, JSON, Markdown (md-editor-rt), plain text — theme-aware and zero-config with injectable upload.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "editor",
    "tiptap",
    "monaco",
    "markdown",
    "rich-text",
    "antd"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/editor-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/editor-react.js"
    },
    "./style.css": "./dist/editor-react.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/flatten-dts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.6.0",
    "antd": ">=6.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-heading": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-horizontal-rule": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-subscript": "^3.23.6",
    "@tiptap/extension-superscript": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "marked": "^18.0.4",
    "md-editor-rt": "^6.5.1",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
