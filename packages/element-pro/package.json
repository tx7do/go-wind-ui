{
  "name": "@go-wind/element-pro",
  "version": "0.2.3",
  "description": "Config-driven CRUD page components for Vue 3 + Element Plus + vxe-table: search bar, toolbar, dual-engine table, pagination, form modal, full-page orchestration.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "vxe-table",
    "admin",
    "crud",
    "pro-components",
    "data-table"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/element-pro.umd.cjs",
  "module": "./dist/element-pro.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/element-pro.js",
      "require": "./dist/element-pro.umd.cjs"
    },
    "./style.css": "./dist/element-pro.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/flatten-dts.mjs",
    "typecheck": "vue-tsc --noEmit",
    "watch": "vite build --watch"
  },
  "peerDependencies": {
    "element-plus": ">=2.13.0",
    "vue": ">=3.5.0",
    "vxe-table": ">=4.6.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.2.1",
    "defu": "^6.1.7",
    "exceljs": "^4.4.0",
    "sortablejs": "^1.15.7",
    "@go-wind/locale": "workspace:*"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.5",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5",
    "vxe-table": "4.18.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
