{
  "name": "@go-wind/editor-vue",
  "version": "0.2.4",
  "description": "Vue 3 editor suite: Tiptap 3 rich text, Monaco code, JSON, Markdown (md-editor-v3), plain text — theme-aware and zero-config with injectable upload.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "editor",
    "tiptap",
    "monaco",
    "markdown",
    "rich-text"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/editor-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/editor-vue.js"
    },
    "./style.css": "./dist/editor-vue.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/flatten-dts.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.5.0",
    "element-plus": ">=2.13.0",
    "@element-plus/icons-vue": ">=2.3.0"
  },
  "dependencies": {
    "@go-wind/locale": "workspace:*",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-heading": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-horizontal-rule": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.0",
    "@tiptap/extension-superscript": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "highlight.js": "^11.11.1",
    "json-editor-vue": "^0.18.1",
    "jsoneditor": "^10.4.3",
    "lowlight": "^3.3.0",
    "marked": "^18.0.3",
    "md-editor-v3": "^6.5.0",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5",
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "element-plus": "^2.13.5",
    "@codemirror/autocomplete": "^6.20.0",
    "@vue/shared": "^3.5.30"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
