{
  "name": "@go-wind-ui/widgets-vue",
  "version": "0.1.0",
  "description": "Admin shell widgets for Vue 3 + Element Plus: notification bell, command palette (Ctrl+K), theme switch, language select — presentational, data injected by the host.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "widgets",
    "notification",
    "command-palette",
    "admin"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/widgets-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/widgets-vue.js"
    },
    "./style.css": "./dist/widgets-vue.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "element-plus": ">=2.13.0",
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@go-wind-ui/locale": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "element-plus": "^2.13.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5"
  }
}
