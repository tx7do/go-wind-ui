{
  "name": "@go-wind-ui/chat-vue",
  "version": "0.1.0",
  "description": "AI streaming chat UI for Vue 3: message list with markdown rendering, typing indicator, auto-scroll, chat input with stop — transport injected by the host.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "chat",
    "ai",
    "streaming",
    "markdown"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/chat-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chat-vue.js"
    },
    "./style.css": "./dist/chat-vue.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@go-wind-ui/locale": "workspace:*",
    "dompurify": "^3.2.0",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5"
  }
}
