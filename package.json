{
  "name": "go-wind-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-generic Vue admin UI building blocks (element-pro, editor, ...) by the GoWind ecosystem.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @go-wind-ui/element-pro build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter playground dev",
    "build:playground": "pnpm --filter playground build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "pnpm": "^10.17.0",
    "@changesets/changelog-github": "^0.5.1"
  }
}
